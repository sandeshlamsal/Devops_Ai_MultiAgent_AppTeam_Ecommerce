FROM node:20-alpine

# Install Claude Code CLI — agents use this instead of the raw API SDK
# Authentication is provided via ~/.claude mounted from the host (covered by Pro plan)
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY agents/ ./agents/

CMD ["npx", "ts-node", "agents/index.ts"]
